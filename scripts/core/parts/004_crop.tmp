# ═══════════════════════════════════
# 🌿 作物（16×16 四阶段，增强版）
# ═══════════════════════════════════

static func generate_crop_sprite(stage: int, type: String = "bluebell") -> ImageTexture:
	var img = create(16, 16)
	# Stage 0: dirt mound
	if stage == 0:
		r(img, 6, 12, 4, 2, PALETTE.d_d)
		r(img, 7, 11, 2, 2, PALETTE.d_l)
		p(img, 7, 10, PALETTE.d_b)
		p(img, 6, 9, PALETTE.g_n)
		p(img, 10, 9, PALETTE.g_n)
		p(img, 8, 9, PALETTE.g_d)
		p(img, 5, 9, PALETTE.g_dd)
		# extra dots
		p(img, 6, 8, PALETTE.g_n)
		p(img, 10, 8, PALETTE.g_n)
		return _upscale2x(img, 32, 32)
	# Stage 0.33: tiny sprout (额外过渡帧)
	if stage == 1:
		r(img, 7, 10, 2, 4, PALETTE.d_d)
		r(img, 7, 9, 2, 2, PALETTE.g_d)
		p(img, 6, 8, PALETTE.g_l)
		p(img, 10, 8, PALETTE.g_l)
		p(img, 5, 8, PALETTE.g_s)
		p(img, 11, 8, PALETTE.g_s)
		# 额外叶子
		p(img, 5, 7, PALETTE.g_ll)
		p(img, 11, 7, PALETTE.g_ll)
		# 土堆细节
		p(img, 6, 11, PALETTE.d_l)
		p(img, 10, 11, PALETTE.d_l)
		return _upscale2x(img, 32, 32)
	# Stage 1.33: developing seedling (额外过渡帧)
	if stage == 2:
		r(img, 7, 8, 2, 8, PALETTE.g_d)
		r(img, 5, 7, 6, 3, PALETTE.g)
		r(img, 6, 6, 4, 2, PALETTE.g_l)
		p(img, 5, 5, PALETTE.g_b)
		p(img, 11, 5, PALETTE.g_b)
		p(img, 4, 6, PALETTE.g_ll)
		p(img, 12, 6, PALETTE.g_ll)
		if type == "bluebell":
			r(img, 6, 4, 4, 3, PALETTE.f_b)
			p(img, 7, 3, PALETTE.f_b)
			p(img, 9, 3, PALETTE.f_b)
			p(img, 7, 2, PALETTE.f_pu)
			p(img, 9, 2, PALETTE.f_pu)
			p(img, 5, 3, PALETTE.f_bd)
			p(img, 11, 3, PALETTE.f_bd)
		else:
			fcirc(img, 8, 5, 3, PALETTE.f_y)
			fcirc(img, 8, 5, 2, PALETTE.f_o)
			p(img, 8, 4, PALETTE.f_yd)
			p(img, 8, 3, Color(1, 1, 1, 0.3))
		return _upscale2x(img, 32, 32)
	# Stage 2.33: nearing maturity (额外过渡帧)
	if stage == 3:
		r(img, 7, 6, 2, 10, PALETTE.g_d)
		r(img, 5, 5, 6, 4, PALETTE.g)
		r(img, 6, 4, 4, 3, PALETTE.g_l)
		p(img, 5, 3, PALETTE.g_b)
		p(img, 11, 3, PALETTE.g_b)
		p(img, 4, 5, PALETTE.g_ll)
		p(img, 12, 5, PALETTE.g_ll)
		if type == "bluebell":
			r(img, 6, 2, 4, 3, PALETTE.f_b)
			p(img, 7, 1, PALETTE.f_b)
			p(img, 9, 1, PALETTE.f_b)
			p(img, 7, 0, PALETTE.f_pu)
			p(img, 9, 0, PALETTE.f_pu)
		else:
			fcirc(img, 8, 3, 4, PALETTE.f_y)
			fcirc(img, 8, 3, 3, PALETTE.f_o)
			p(img, 8, 2, Color(1, 1, 1, 0.3))
		return _upscale2x(img, 32, 32)
	# Stage 3: mature plant (默认, stage >= 4)
	r(img, 7, 5, 2, 10, PALETTE.g_d)
	p(img, 5, 8, PALETTE.g_l)
	p(img, 11, 8, PALETTE.g_l)
	p(img, 4, 6, PALETTE.g_ll)
	p(img, 12, 6, PALETTE.g_ll)
	if type == "bluebell":
		fcirc(img, 6, 4, 4, PALETTE.f_b)
		fcirc(img, 10, 3, 4, PALETTE.f_b)
		fcirc(img, 8, 5, 3, PALETTE.f_pu)
		p(img, 4, 2, PALETTE.f_bd)
		p(img, 12, 1, PALETTE.f_bd)
		p(img, 7, 2, PALETTE.f_y)
		p(img, 9, 2, PALETTE.f_y)
		p(img, 5, 3, Color(1, 1, 1, 0.3))
		p(img, 9, 2, Color(1, 1, 1, 0.3))
		p(img, 6, 1, PALETTE.f_b)
		p(img, 10, 1, PALETTE.f_b)
		p(img, 5, 1, PALETTE.f_pu)
		p(img, 11, 1, PALETTE.f_pu)
	else:
		fcirc(img, 8, 4, 5, PALETTE.f_y)
		fcirc(img, 8, 4, 3, PALETTE.f_o)
		fcirc(img, 8, 4, 1, Color("#c06050"))
		p(img, 8, 2, Color(1, 1, 1, 0.3))
		p(img, 6, 1, PALETTE.f_yd)
		p(img, 10, 1, PALETTE.f_yd)
	return _upscale2x(img, 32, 32)
